# Copy to `.env` (never commit it) and fill in before `docker compose -f docker-compose.prod.yml up -d`.

# Required: compose refuses to start without it. Use a long random value, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# Optional overrides (defaults shown).
POSTGRES_DB=overclock
POSTGRES_USER=overclock

# Host port the bundled nginx listens on. Put a TLS-terminating proxy / tunnel in front of it.
FRONTEND_PORT=80

# What sits in front of nginx decides where the player's real IP comes from (per-IP rate limits):
#   ./frontend/nginx-real-ip.conf            Cloudflare Tunnel / proxied Cloudflare DNS (default)
#   ./frontend/nginx-real-ip-tailscale.conf  Tailscale Funnel
REAL_IP_CONF=./frontend/nginx-real-ip.conf
